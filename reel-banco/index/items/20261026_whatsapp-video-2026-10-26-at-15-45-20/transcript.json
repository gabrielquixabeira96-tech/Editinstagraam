.58,"prob":0.503,"raw":"aqui"},{"word":"o","start":83.58,"end":83.64,"prob":0.654,"raw":"o"},{"word":"meu","start":83.64,"end":83.74,"prob":0.996,"raw":"meu"},{"word":"perfil.","start":83.74,"end":84.16,"prob":0.994,"raw":"perfil."}],"segments":[{"start":0.78,"end":6.04,"text":"Doutor, mas é verdade que somos mais altos pela manhã do que no final do dia?","avg_logprob":-0.19,"no_speech_prob":0.293},{"start":6.86,"end":14.04,"text":"Sim, é verdade. Essa diferença pode chegar a quase dois centímetros e isso acontece por conta dos discos intervertebrais,","avg_logprob":-0.19,"no_speech_prob":0.293},{"start":14.12,"end":20.86,"text":"que são estruturas que ficam entre as nossas vértebras na nossa coluna e funcionam como espécie de amortecedores naturais.","avg_logprob":-0.19,"no_speech_prob":0.293},{"start":21.5,"end":29.98,"text":"Esses discos possuem uma região central chamada de núcleo pulposo, que é como se fosse uma gelatininha ali no centro do disco, que é rica em água.","avg_logprob":-0.19,"no_speech_prob":0.293},{"start":29.98,"end":34.92,"text":"E ao longo do dia, enquanto caminhamos, ficamos em pé, realizamos nossas atividades habituais,","avg_logprob":-0.223,"no_speech_prob":0.278},{"start":35.54,"end":41.42,"text":"a pressão exercida sobre a coluna faz com que esses discos percam parte desse conteúdo de água.","avg_logprob":-0.223,"no_speech_prob":0.278},{"start":42.12,"end":44.4,"text":"E isso diminui discretamente a altura do disco.","avg_logprob":-0.223,"no_speech_prob":0.278},{"start":44.62,"end":51.94,"text":"Durante a noite, enquanto estamos deitados, essa pressão diminui permitindo que os discos recuperem parte dessa altura.","avg_logprob":-0.223,"no_speech_prob":0.278},{"start":52.5,"end":54.84,"text":"E que existe uma curiosidade interessante.","avg_logprob":-0.223,"no_speech_prob":0.278},{"start":54.84,"end":59.34,"text":"é interessante, os discos intervertebrais praticamente não possuem invasos sanguíneos,","avg_logprob":-0.167,"no_speech_prob":0.373},{"start":59.58,"end":63.32,"text":"por isso sua nutrição ocorre principalmente por um processo chamado de difusão.","avg_logprob":-0.167,"no_speech_prob":0.373},{"start":64.02,"end":67.24,"text":"Daí a importância da prática de atividade física, como caminhada,","avg_logprob":-0.167,"no_speech_prob":0.373},{"start":68.42,"end":74.42,"text":"caminhada rápida, corrida leve, ou seja, os discos da nossa coluna são estruturas dinâmicas","avg_logprob":-0.167,"no_speech_prob":0.373},{"start":74.42,"end":77.74,"text":"e eles respondem constantemente às cargas do nosso dia a dia.","avg_logprob":-0.167,"no_speech_prob":0.373},{"start":77.74,"end":83.48,"text":"Se você quer entender melhor como cuidar da sua coluna e prevenir problemas, acompanhe","avg_logprob":-0.26,"no_speech_prob":0.028},{"start":83.48,"end":84.16,"text":"aqui o meu perfil.","avg_logprob":-0.26,"no_speech_prob":0.028}]}