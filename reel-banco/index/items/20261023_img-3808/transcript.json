   "avg_logprob": -0.239,
   "no_speech_prob": 0.423
  },
  {
   "start": 50.02,
   "end": 56.38,
   "text": "Connector de PubMed e com uma didática bem detalhada que ensina",
   "avg_logprob": -0.239,
   "no_speech_prob": 0.423
  },
  {
   "start": 56.38,
   "end": 62.74,
   "text": "conteúdos principalmente de medicina e cirurgia. Eu acho que qualquer pergunta pode",
   "avg_logprob": -0.239,
   "no_speech_prob": 0.423
  },
  {
   "start": 62.74,
