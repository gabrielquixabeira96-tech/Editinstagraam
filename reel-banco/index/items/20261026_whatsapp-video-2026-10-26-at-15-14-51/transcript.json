},{"word":"Quero","start":112.93,"end":113.04,"prob":0.688,"raw":"Quero","raw_start":112.88,"raw_end":113.04},{"word":"entender","start":113.04,"end":113.34,"prob":0.999,"raw":"entender"},{"word":"como","start":113.34,"end":113.7,"prob":0.984,"raw":"como"},{"word":"isso","start":113.7,"end":113.94,"prob":0.972,"raw":"isso"},{"word":"se","start":113.94,"end":114.06,"prob":0.988,"raw":"se"},{"word":"relaciona","start":114.06,"end":114.52,"prob":0.987,"raw":"relaciona"},{"word":"com","start":114.52,"end":114.66,"prob":0.979,"raw":"com"},{"word":"hérnias","start":114.66,"end":114.92,"prob":0.727,"raw":"hérnias"},{"word":"de","start":114.92,"end":115.02,"prob":0.992,"raw":"de"},{"word":"disco,","start":115.02,"end":115.38,"prob":0.96,"raw":"disco,"},{"word":"exercícios","start":115.68,"end":116.08,"prob":0.965,"raw":"exercícios"},{"word":"físicos","start":116.08,"end":116.52,"prob":0.991,"raw":"físicos"},{"word":"e","start":116.54,"end":116.63,"prob":0.708,"raw":"e","raw_start":116.52,"raw_end":117.04},{"word":"saúde","start":117.04,"end":117.24,"prob":0.925,"raw":"saúde"},{"word":"da","start":117.24,"end":117.42,"prob":0.995,"raw":"da"},{"word":"nossa","start":117.42,"end":117.56,"prob":0.978,"raw":"nossa"},{"word":"coluna,","start":117.56,"end":117.96,"prob":0.995,"raw":"coluna,"},{"word":"compõe","start":118.36,"end":118.84,"prob":0.723,"raw":"compõe","raw_start":118.2,"raw_end":118.84},{"word":"aqui","start":118.84,"end":119.02,"prob":0.928,"raw":"aqui"},{"word":"o","start":119.02,"end":119.34,"prob":0.941,"raw":"o"},{"word":"meu","start":119.34,"end":119.46,"prob":0.993,"raw":"meu"},{"word":"perfil.","start":119.46,"end":119.78,"prob":0.555,"raw":"perfil."}],"segments":[{"start":0.72,"end":5.74,"text":"Você sabia que podemos acordar até dois centímetros mais altos do que quando fomos dormir?","avg_logprob":-0.159,"no_speech_prob":0.041},{"start":6.2,"end":8.22,"text":"A explicação está na nossa coluna vertebral.","avg_logprob":-0.159,"no_speech_prob":0.041},{"start":8.8,"end":13.84,"text":"Entre as vértebras da nossa coluna, existem estruturas chamadas discos intervertebrais,","avg_logprob":-0.159,"no_speech_prob":0.041},{"start":13.92,"end":17.22,"text":"que funcionam como verdadeiros amortecedores naturais.","avg_logprob":-0.159,"no_speech_prob":0.041},{"start":18.0,"end":21.7,"text":"Esses discos possuem uma região central, chamada de núcleo pulposo,","avg_logprob":-0.159,"no_speech_prob":0.041},{"start":22.36,"end":27.22,"text":"que é rica em água, uma espécie de gelatina que fica ali no centro do nosso disco.","avg_logprob":-0.159,"no_speech_prob":0.041},{"start":27.22,"end":32.9,"text":"Ao longo do dia, o peso do nosso corpo provoca uma perda gradual do líquido desses discos,","avg_logprob":-0.153,"no_speech_prob":0.054},{"start":33.06,"end":36.16,"text":"o que reduz discretamente a altura deles.","avg_logprob":-0.153,"no_speech_prob":0.054},{"start":36.8,"end":41.06,"text":"Durante a noite, quando estamos deitados, ocorre o processo inverso.","avg_logprob":-0.153,"no_speech_prob":0.054},{"start":41.58,"end":46.46,"text":"Os discos recuperam parte dessa água e, consequentemente, a sua altura.","avg_logprob":-0.153,"no_speech_prob":0.054},{"start":47.3,"end":55.02,"text":"Então, se você pretende ter uma altura maior, aconselho que faça essa medição logo pela manhã.","avg_logprob":-0.153,"no_speech_prob":0.054},{"start":55.68,"end":61.46,"text":"Só que existe um detalhe ainda mais interessante, os discos praticamente não possuem vasos sanguíneos,","avg_logprob":-0.205,"no_speech_prob":0.187},{"start":61.82,"end":68.0,"text":"por isso que a nutrição deles depende principalmente de um processo chamado difusão, e aí que","avg_logprob":-0.205,"no_speech_prob":0.187},{"start":68.0,"end":73.48,"text":"a importância de nós nos movimentarmos bem, por isso que sempre indica aos meus pacientes","avg_logprob":-0.205,"no_speech_prob":0.187},{"start":73.48,"end":82.28,"text":"e orienta aos meus colegas que o repouso absoluto, em um caso de dor de coluna, é a pior","avg_logprob":-0.205,"no_speech_prob":0.187},{"start":82.28,"end":87.68,"text":"coisa que eles podem fazer. Claro que cada caso deve ser avaliado, estudado de forma","avg_logprob":-0.243,"no_speech_prob":0.167},{"start":87.68,"end":95.8,"text":"individual, mas nós sabemos, estudos já nos dizem isso, que caminhada leve,","avg_logprob":-0.243,"no_speech_prob":0.167},{"start":95.96,"end":99.7,"text":"corrida são as sociadas características mais favoráveis de hidratação do disco,","avg_logprob":-0.243,"no_speech_prob":0.167},{"start":100.02,"end":105.7,"text":"embora isso não estabeleça uma relação direta de causa e efeito, nós sabemos","avg_logprob":-0.243,"no_speech_prob":0.167},{"start":105.7,"end":110.38,"text":"que quanto maior a mobilidade, maior a saúde do nosso disco, ou seja, nossa","avg_logprob":-0.243,"no_speech_prob":0.167},{"start":110.38,"end":114.06,"text":"coluna é muito mais dinâmica do que parece. Quero entender como isso se","avg_logprob":-0.301,"no_speech_prob":0.032},{"start":114.06,"end":117.96,"text":"relaciona com hérnias de disco, exercícios físicos e saúde da nossa coluna,","avg_logprob":-0.301,"no_speech_prob":0.032},{"start":118.2,"end":119.78,"text":"compõe aqui o meu perfil.","avg_logprob":-0.301,"no_speech_prob":0.032}]}