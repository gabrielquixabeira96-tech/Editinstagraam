 "captions": [
   [0,5,"Então, a úlcera duodenal|anterior perfura"],
   [6,9,"e a posterior sangra."],
   [10,14,"O motivo é puramente|anatômico."],
   [15,18,"Se você olhar aqui,"],
   [19,26,"na frente do bulbo|não tem nada encostando."],
   [27,32,"Então a úlcera|atravessa a parede"],
   [33,37,"e abre direto|no peritônio."],
   [38,41,"Aí o ar sobe"],
   [42,47,"e, em pé, ele para|embaixo do diafragma."],
   [48,54,"Só que atrás do bulbo|passa a gastroduodenal,"],
   [55,61,"e aí a úlcera posterior|vai digerindo"],
   [62,66,"a parede dela|até romper."],
   [67,73,"E aí que vem|o Forrest Ia,"],
   [74,77,"que é o jato,"],
   [78,83,"ou a babação,|que é o Ib."],
   [84,89,"O detalhe é que|essa artéria"],
   [90,97,"recebe sangue por|três entradas diferentes:"],
   [98,105,"de cima,|pela hepática comum;"],
   [106,112,"de baixo, pela|mesentérica superior;"],
   [113,114,"e pelo lado."],
   [115,122,"Então, um ponto só|no fundo da úlcera"],
   [123,125,"fecha o furo,"],
   [126,129,"mas o sangramento volta."],
   [130,136,"Por isso que|a ligadura é tripla:"],
   [137,140,"um ponto cranial,"],
   [141,143,"um ponto caudal"],
   [144,149,"e um ponto em U medial,"],
   [150,153,"sem pegar o colédoco."],
   [154,159,"E quando a segunda|endoscopia falha,"],
   [160,167,"a ACG e a ESGE indicam|uma embolização"],
   [168,170,"antes da cirurgia,"],
   [171,178,"com uma mola que é colocada|no lado oposto."],
   [179,184,"Eu deixei esse|atlas inteiro"],
   [185,190,"ali nesse link aqui embaixo,|quem quiser pode pegar."],
   [191,196,"Não deu tempo|de mostrar tudo,"],
   [197,204,"mas o atlas é|bem mais completo."]
 ],
